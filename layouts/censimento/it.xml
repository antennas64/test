<layouts>

  <!-- =========================================================
       CENSIMENTO CERVI V3
       Layout principale
       ========================================================= -->

  <layout name="root">

    <row>
      <button type="page"
              label="VISTO"
              targetlayout="visto" />

      <button type="page"
              label="SOLO UDITO"
              targetlayout="udito" />
    </row>

    <row>
      <button type="picture"
              label="FOTO" />

      <button type="textnote"
              label="OSSERVAZIONI" />
    </row>

    <row>
      <button type="tag"
              label="POSSIBILE RICONTATTO" />

      <button type="page"
              label="SESSIONE"
              targetlayout="sessione" />
    </row>

  </layout>


  <!-- =========================================================
       VISTO - SITUAZIONE OSSERVATA
       ========================================================= -->

  <layout name="visto">

    <row>
      <button type="page"
              label="SINGOLO"
              targetlayout="singolo" />

      <button type="page"
              label="FEMMINA CON PICCOLO"
              targetlayout="femmina_piccolo" />
    </row>

    <row>
      <button type="page"
              label="GRUPPO MATRIARCALE"
              targetlayout="gruppo_matriarcale" />

      <button type="page"
              label="HAREM"
              targetlayout="harem" />
    </row>

    <row>
      <button type="page"
              label="GRUPPO MASCHILE"
              targetlayout="gruppo_maschile" />

      <button type="page"
              label="INDIETRO"
              targetlayout="root" />
    </row>

  </layout>


  <!-- =========================================================
       SOLO UDITO - CLASSE STIMATA DAL BRAMITO
       ========================================================= -->

  <layout name="udito">

    <row>
      <button type="tag"
              label="MASCHIO ADULTO" />

      <button type="tag"
              label="MASCHIO SUBADULTO" />
    </row>

    <row>
      <button type="textnote"
              label="OSSERVAZIONI" />

      <button type="page"
              label="INDIETRO"
              targetlayout="root" />
    </row>

  </layout>


  <!-- =========================================================
       SINGOLO / INDIVIDUI NON IN GRUPPO
       ========================================================= -->

  <layout name="singolo">

    <row>
      <button type="textnote"
              label="N. MASCHIO ADULTO" />

      <button type="textnote"
              label="N. MASCHIO SUBADULTO" />
    </row>

    <row>
      <button type="textnote"
              label="N. MASCHIO GIOVANE" />

      <button type="textnote"
              label="N. FEMMINA ADULTA" />
    </row>

    <row>
      <button type="textnote"
              label="N. FEMMINA GIOVANE" />

      <button type="textnote"
              label="N. PICCOLO DA SOLO" />
    </row>

    <row>
      <button type="textnote"
              label="N. INDETERMINATO" />

      <button type="textnote"
              label="N. IN BRAMITO" />
    </row>

    <row>
      <button type="page"
              label="INDIETRO"
              targetlayout="visto" />
    </row>

  </layout>


  <!-- =========================================================
       FEMMINA CON PICCOLO
       ========================================================= -->

  <layout name="femmina_piccolo">

    <row>
      <button type="tag"
              label="FEMMINA CON PICCOLO" />

      <button type="textnote"
              label="NUMERO PICCOLI" />
    </row>

    <row>
      <button type="page"
              label="INDIETRO"
              targetlayout="visto" />
    </row>

  </layout>


  <!-- =========================================================
       GRUPPO MATRIARCALE
       ========================================================= -->

  <layout name="gruppo_matriarcale">

    <row>
      <button type="textnote"
              label="N. MASCHI ADULTI" />

      <button type="textnote"
              label="N. MASCHI SUBADULTI" />
    </row>

    <row>
      <button type="textnote"
              label="N. MASCHI GIOVANI" />

      <button type="textnote"
              label="N. FEMMINE ADULTE" />
    </row>

    <row>
      <button type="textnote"
              label="N. FEMMINE GIOVANI" />

      <button type="textnote"
              label="N. PICCOLI" />
    </row>

    <row>
      <button type="textnote"
              label="N. INDETERMINATI" />

      <button type="page"
              label="INDIETRO"
              targetlayout="visto" />
    </row>

  </layout>


  <!-- =========================================================
       HAREM
       ========================================================= -->

  <layout name="harem">

    <row>
      <button type="textnote"
              label="N. MASCHI ADULTI" />

      <button type="textnote"
              label="N. MASCHI SUBADULTI" />
    </row>

    <row>
      <button type="textnote"
              label="N. MASCHI GIOVANI" />

      <button type="textnote"
              label="N. FEMMINE ADULTE" />
    </row>

    <row>
      <button type="textnote"
              label="N. FEMMINE GIOVANI" />

      <button type="textnote"
              label="N. INDETERMINATI" />
    </row>

    <row>
      <button type="page"
              label="INDIETRO"
              targetlayout="visto" />
    </row>

  </layout>


  <!-- =========================================================
       GRUPPO MASCHILE
       ========================================================= -->

  <layout name="gruppo_maschile">

    <row>
      <button type="textnote"
              label="N. ADULTI" />

      <button type="textnote"
              label="N. SUBADULTI" />
    </row>

    <row>
      <button type="textnote"
              label="N. GIOVANI" />

      <button type="textnote"
              label="N. INDETERMINATI" />
    </row>

    <row>
      <button type="page"
              label="INDIETRO"
              targetlayout="visto" />
    </row>

  </layout>


  <!-- =========================================================
       SESSIONE / CONTESTO MINIMO
       ========================================================= -->

  <layout name="sessione">

    <row>
      <button type="tag"
              label="TRANSETTO" />

      <button type="tag"
              label="POSTAZIONE FISSA" />
    </row>

    <row>
      <button type="textnote"
              label="OPERATORE" />

      <button type="textnote"
              label="SESSIONE N." />
    </row>

    <row>
      <button type="textnote"
              label="LUOGO OSSERVAZIONE" />

      <button type="textnote"
              label="TOTALE CERVI" />
    </row>

    <row>
      <button type="page"
              label="INDIETRO"
              targetlayout="root" />
    </row>

  </layout>

</layouts>
